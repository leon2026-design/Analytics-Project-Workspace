# .gitignore for Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.env
.env
.DS_Store
*.sqlite3
*.log
.ipynb_checkpoints/
venv/
ENV/
env/

# IDE/editor
.vscode/
.idea/

# Data & models - do not commit large data or binary model files
backend/data/
backend/models/*.pkl
backend/models/*.joblib

# Allow placeholder files so directories are visible to teammates
!backend/data/.gitkeep
!backend/models/.gitkeep

# Notebook checkpoints
.ipynb_checkpoints/

# Test / typecheck caches
.pytest_cache/
.mypy_cache/

# Logs
*.log
